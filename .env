# Copy to .env and edit. Never commit .env.
# (Comments are on their own lines on purpose: some tools do not strip inline comments.)

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/fgr.db
# Required (16+ chars) when APP_ENV=production. Not used for auth until Phase 7.
API_TOKEN=
DEFAULT_TIMEZONE=Asia/Jakarta
STEAM_REGION=ID
STEAM_CURRENCY=IDR
GIVEAWAY_SCAN_INTERVAL_MINUTES=30
PRICE_SCAN_INTERVAL_MINUTES=360
WISHLIST_SYNC_INTERVAL_MINUTES=1440
REMINDER_OFFSETS_MINUTES=1440,360,60,30
HTTP_TIMEOUT_SECONDS=15
USER_AGENT=FreeGameRadar/0.1 (contact: you@example.com)

# Optional integrations (leave empty until their phases)
STEAM_WEB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ITAD_API_KEY=
